# Copy to .env.local for local development. Set the same names in Vercel for
# production (Settings -> Environment Variables), then redeploy: env changes only
# take effect on a new deployment. Never commit real values.

# --- auth -------------------------------------------------------------------
# Shared secret for the single-user gate. Open the app once with ?k=<value>; it
# sets a year-long httpOnly cookie. Long and random: `openssl rand -base64 32`.
APP_SECRET=

# Bearer secret Vercel Cron sends to /api/cron/*. Vercel sets this header itself
# when a variable with this exact name exists.
CRON_SECRET=

# --- data -------------------------------------------------------------------
# The private repo that holds the program, logs and briefs (owner/name).
DATA_REPO=
# Branch to read and write. Defaults to main.
DATA_BRANCH=main
# Fine-grained personal access token, scoped to DATA_REPO only:
#   Contents: Read and write · Metadata: Read-only · nothing else · with an expiry.
# The code repo must NOT be writable with this token.
DATA_TOKEN=

# --- integrations -------------------------------------------------------------
# Hevy API key (Hevy Pro -> Settings -> Developer).
HEVY_API_KEY=
# Beyond Power (Voltra) API key.
VOLTRA_API_KEY=
